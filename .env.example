# Local development
DATABASE_URL=postgresql://strategist:strategist_dev@localhost:5432/strategist_cockpit
USE_MOCK_BACKEND=false

# Databricks
DATABRICKS_HOST=https://adb-2548836972759138.18.azuredatabricks.net
# Required for local dev: every state-changing route depends on the OBO
# token (current_user_token). When running under Databricks Apps the proxy
# injects X-Forwarded-Access-Token; locally we fall back to this env var.
# Any non-empty string works for SQLite-mode dev (the value is never sent
# upstream); for DBSQL-mode dev use a real PAT scoped to the warehouse.
DATABRICKS_TOKEN=<your-token>
DATABRICKS_WAREHOUSE_ID=071969b1ec9a91ca

# Stratego Knowledge Assistant
STRATEGO_ENDPOINT_NAME=<ka-endpoint-name>
